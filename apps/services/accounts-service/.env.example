# Referencia completa: docs/environment-reference.md. Copia este archivo a .env; no versionar .env.
# Identidad y diagnóstico de Laravel (APP_DEBUG sólo debe ser true en desarrollo).
APP_NAME="Catálogo de Aves — Cuentas"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Conexión exclusiva a la base lógica de Accounts; no reutilizar para otro servicio.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=catalogo_aves_accounts
DB_USERNAME=catalogo_aves
DB_PASSWORD=catalogo_aves_dev
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

# Sesión Laravel, cache y trabajos locales. La autenticación de la SPA usa JWT.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hola@catalogo-aves.local"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Accounts es el emisor: conserva la privada y publica la clave RSA de verificación.
JWT_ISSUER=catalogo-aves-accounts
JWT_ACCESS_TTL_MINUTES=15
JWT_PRIVATE_KEY_PATH=storage/app/keys/jwt-private.pem
JWT_PUBLIC_KEY_PATH=storage/app/keys/jwt-public.pem
# Valores de desarrollo local; se pueden sobrescribir sin versionar el .env.
SUPERADMIN_EMAIL=admin@catalogo-aves.local
SUPERADMIN_NAME="Catálogo de Aves Admin"
SUPERADMIN_PASSWORD="CatalogoAvesAdmin2026!"
