# Referencia completa: docs/environment-reference.md. Este .env pertenece sólo a Observation.
# Identidad y diagnóstico local; APP_DEBUG nunca debe permanecer activo fuera de desarrollo.
APP_NAME="Catálogo de Aves — Observaciones"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8003
# Base lógica propiedad de Observation; los ids externos no son foreign keys entre bases.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=catalogo_aves_observation
DB_USERNAME=catalogo_aves
DB_PASSWORD=catalogo_aves_dev
# Dependencia HTTP de sólo lectura para decidir sensibilidad antes de publicar.
CATALOG_URL=http://localhost:8002
# Observation sólo verifica JWT; prepare copia aquí la clave pública de Accounts.
JWT_ISSUER=catalogo-aves-accounts
JWT_PUBLIC_KEY_PATH=storage/app/keys/jwt-public.pem
