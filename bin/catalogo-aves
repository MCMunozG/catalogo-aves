#!/usr/bin/env sh
set -eu

SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
ROOT_DIR=$(CDPATH= cd -- "$SCRIPT_DIR/.." && pwd)
cd "$ROOT_DIR"

command="${1:-help}"
target="${2:-all}"
service_dir() {
  case "$1" in
    accounts) echo accounts-service;; catalog) echo catalog-service;; observation) echo observation-service;; community) echo community-service;; *) echo "Unknown service: $1" >&2; exit 2;;
  esac
}
service_path() { echo "apps/services/$(service_dir "$1")"; }
service_port() { case "$1" in accounts) echo 8001;; catalog) echo 8002;; observation) echo 8003;; community) echo 8004;; *) echo "Unknown service: $1" >&2; exit 2;; esac; }
ensure_service_dependencies() {
  requested_service="$1"
  path="$(service_path "$requested_service")"

  # Composer dependencies are intentionally ignored by Git. Restore the exact
  # locked dependency set before invoking Artisan in a fresh working copy.
  if [ ! -f "$path/vendor/autoload.php" ]; then
    echo "Installing Composer dependencies for $requested_service..."
    (cd "$path" && composer install --no-interaction --prefer-dist)
  fi
}
ensure_service_environment() {
  requested_service="$1"
  path="$(service_path "$requested_service")"

  # Un clon nuevo no contiene .env de forma intencional. Copiar sólo si falta evita
  # sobrescribir las credenciales locales y rutas JWT de quien desarrolla.
  if [ ! -f "$path/.env" ]; then
    cp "$path/.env.example" "$path/.env"
    echo "Created $path/.env from .env.example."
  fi

  # Laravel necesita APP_KEY para iniciar funciones cifradas. key:generate es idempotente
  # aquí porque sólo se ejecuta cuando el valor está vacío.
  if grep -q '^APP_KEY=$' "$path/.env"; then
    (cd "$path" && php artisan key:generate --force --ansi)
  fi
}
ensure_jwt_key_material() {
  accounts_path="$(service_path accounts)"

  # Accounts es el único emisor JWT. Laravel resuelve sus rutas configuradas y
  # sólo comparte la clave pública con los servicios locales que validan tokens.
  ensure_service_environment accounts
  (cd "$accounts_path" && CATALOGO_AVES_OPENSSL_BINARY="$(command -v openssl || true)" php artisan catalogo-aves:jwt-keys --ansi)

  public_key="$accounts_path/storage/app/keys/jwt-public.pem"
  for consumer in catalog observation community; do
    consumer_path="$(service_path "$consumer")"
    mkdir -p "$consumer_path/storage/app/keys"
    cp "$public_key" "$consumer_path/storage/app/keys/jwt-public.pem"
  done
}
run_service() {
  requested_service="$1"
  shift
  ensure_service_dependencies "$requested_service"
  (cd "$(service_path "$requested_service")" && php artisan "$@")
}
run_all() { for name in accounts catalog observation community; do run_service "$name" "$@"; done; }
prepare_service() {
  ensure_service_dependencies "$1"
  ensure_service_environment "$1"
  ensure_jwt_key_material
  if ! (cd "$(service_path "$1")" && php artisan migrate --force && php artisan db:seed --force); then
    echo "Failed to prepare $1. If MySQL rejects user 'catalogo_aves', run infra/mysql/workbench-local.sql as a MySQL administrator, then retry." >&2
    return 1
  fi
}
prepare_all() { for name in accounts catalog observation community; do prepare_service "$name"; done; }
case "$command" in
  up) if [ "$target" = all ]; then docker compose up -d; else docker compose up -d "$(service_dir "$target")"; fi;;
  down) docker compose down;;
  migrate|seed|test) if [ "$target" = all ]; then run_all "$command"; else run_service "$target" "$command"; fi;;
  prepare) if [ "$target" = all ]; then prepare_all; else prepare_service "$target"; fi;;
  fresh) if [ "$target" = all ]; then run_all migrate:fresh --seed; else run_service "$target" migrate:fresh --seed; fi;;
  web)
    action="${2:-serve}"
    case "$action" in
      install) (cd apps/web && npm install);;
      serve|start) (cd apps/web && npm start);;
      build) (cd apps/web && npm run build);;
      *) echo 'Usage: bash bin/catalogo-aves web {install|serve|build}' >&2; exit 2;;
    esac;;
  service)
    action="${2:?action required}"; name="${3:?service required}"
    case "$action" in
      up) docker compose up -d "$(service_dir "$name")";;
      # Laravel requiere --no-reload con PHP_CLI_SERVER_WORKERS. Sólo desactiva el
      # reinicio automático por cambios en .env; el código fuente sigue evaluándose por petición.
      serve|local) prepare_service "$name" && (cd "$(service_path "$name")" && php artisan serve --no-reload --host=127.0.0.1 --port="$(service_port "$name")");;
      *) echo 'Usage: bash bin/catalogo-aves service {up|serve} {accounts|catalog|observation|community}' >&2; exit 2;;
    esac;;
  *) echo 'Usage: bash bin/catalogo-aves {up|down|migrate|seed|prepare|fresh|test} [accounts|catalog|observation|community]'; echo '       bash bin/catalogo-aves web {install|serve|build}'; echo '       bash bin/catalogo-aves service {up|serve} {accounts|catalog|observation|community}';;
esac
